# Settings for the local development Ghostfolio only. Nothing here is a real secret.

# CACHE
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ghostfolio-dev

# POSTGRES
POSTGRES_DB=ghostfolio-db
POSTGRES_USER=ghostfolio
POSTGRES_PASSWORD=ghostfolio-dev

# VARIOUS
ACCESS_TOKEN_SALT=ghostfolio-importer-dev-salt-not-secret
DATABASE_URL=postgresql://ghostfolio:ghostfolio-dev@postgres:5432/ghostfolio-db?connect_timeout=300
JWT_SECRET_KEY=ghostfolio-importer-dev-jwt-key-not-secret
