{
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "outDir": "dist",
        "esModuleInterop": true,
        "strict": true,
        "noImplicitReturns": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noEmit": true
    },
    "include": ["src", "tests"]
}
